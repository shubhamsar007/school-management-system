generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
  schemas   = ["core", "iam", "hr", "academics", "students", "attendance", "admissions", "finance", "examinations", "ops", "comms", "filestore", "health"]
}

// ─────────────────────────────────────────────
// SCHEMA: core
// ─────────────────────────────────────────────

model Organization {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(200)
  code       String   @unique @db.VarChar(50)
  type       String   @db.VarChar(50)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(30)
  website    String?  @db.VarChar(255)
  timezone   String   @default("Asia/Kolkata") @db.VarChar(50)
  currency   String   @default("INR") @db.Char(3)
  country    String   @default("IN") @db.Char(2)
  status     String   @default("ACTIVE") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  campuses         Campus[]
  academicYears    AcademicYear[]
  academicClasses  AcademicClass[]
  subjects         Subject[]
  employees        Employee[]
  students         Student[]
  users            User[]
  roles            Role[]
  employeeTypes    EmployeeType[]
  departments      Department[]
  designations     Designation[]
  settings         Setting[]
  domainEvents     DomainEvent[]
  auditLogs        AuditLog[]

  @@map("organizations")
  @@schema("core")
}

model Campus {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  name                 String    @db.VarChar(200)
  code                 String    @db.VarChar(50)
  addressId            String?   @map("address_id")
  phone                String?   @db.VarChar(30)
  email                String?   @db.VarChar(255)
  principalEmployeeId  String?   @map("principal_employee_id")
  status               String    @default("ACTIVE") @db.VarChar(20)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  address       Address?     @relation(fields: [addressId], references: [id])
  sections      Section[]
  departments   Department[]
  periods       Period[]
  buildings     Building[]
  employees     Employee[]
  userRoles     UserRole[]

  @@unique([organizationId, code])
  @@map("campuses")
  @@schema("core")
}

model Address {
  id           String   @id @default(uuid())
  addressLine1 String   @map("address_line_1") @db.VarChar(255)
  addressLine2 String?  @map("address_line_2") @db.VarChar(255)
  landmark     String?  @db.VarChar(255)
  city         String   @db.VarChar(100)
  district     String?  @db.VarChar(100)
  state        String   @db.VarChar(100)
  postalCode   String   @map("postal_code") @db.VarChar(20)
  country      String   @default("IN") @db.Char(2)
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campuses Campus[]

  @@map("addresses")
  @@schema("core")
}

model Setting {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String   @db.VarChar(200)
  value          Json
  valueType      String   @map("value_type") @db.VarChar(20)
  category       String   @db.VarChar(100)
  updatedBy      String?  @map("updated_by")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("settings")
  @@schema("core")
}

model DomainEvent {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  eventType      String    @map("event_type") @db.VarChar(200)
  aggregateType  String    @map("aggregate_type") @db.VarChar(100)
  aggregateId    String    @map("aggregate_id")
  payload        Json
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  processedAt    DateTime? @map("processed_at")
  status         String    @default("PENDING") @db.VarChar(20)

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("domain_events")
  @@schema("core")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String   @db.VarChar(50)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id")
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("audit_logs")
  @@schema("core")
}

// ─────────────────────────────────────────────
// SCHEMA: iam
// ─────────────────────────────────────────────

model Person {
  id               String    @id @default(uuid())
  firstName        String    @map("first_name") @db.VarChar(100)
  middleName       String?   @map("middle_name") @db.VarChar(100)
  lastName         String    @map("last_name") @db.VarChar(100)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           String?   @db.VarChar(20)
  profilePhotoFileId String? @map("profile_photo_file_id")
  email            String?   @db.VarChar(255)
  phone            String?   @db.VarChar(30)
  alternatePhone   String?   @map("alternate_phone") @db.VarChar(30)
  bloodGroup       String?   @map("blood_group") @db.VarChar(5)
  nationality      String?   @default("Indian") @db.VarChar(50)
  preferredName    String?   @map("preferred_name") @db.VarChar(50)
  motherTongue     String?   @map("mother_tongue") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  user      User?
  student   Student?
  employee  Employee?
  guardian  Guardian?
  addresses PersonAddress[]

  @@map("persons")
  @@schema("iam")
}

model PersonAddress {
  id         String   @id @default(uuid())
  personId   String   @map("person_id")
  type       String   @db.VarChar(20)
  line1      String?  @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  city       String?  @db.VarChar(100)
  state      String?  @db.VarChar(100)
  country    String?  @default("India") @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id])

  @@map("person_addresses")
  @@schema("iam")
}

model User {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  personId            String    @unique @map("person_id")
  username            String?   @db.VarChar(100)
  email               String    @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  status              String    @default("ACTIVE") @db.VarChar(20)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  person       Person       @relation(fields: [personId], references: [id])
  userRoles    UserRole[]

  @@unique([organizationId, email])
  @@map("users")
  @@schema("iam")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String   @db.VarChar(100)
  code           String   @db.VarChar(50)
  description    String?
  isSystemRole   Boolean  @default(false) @map("is_system_role")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, code])
  @@map("roles")
  @@schema("iam")
}

model Permission {
  id          String @id @default(uuid())
  module      String @db.VarChar(100)
  resource    String @db.VarChar(100)
  action      String @db.VarChar(50)
  description String?

  rolePermissions RolePermission[]

  @@unique([module, resource, action])
  @@map("permissions")
  @@schema("iam")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("iam")
}

model UserRole {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  roleId   String  @map("role_id")
  campusId String? @map("campus_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id])

  @@unique([userId, roleId, campusId])
  @@map("user_roles")
  @@schema("iam")
}

// ─────────────────────────────────────────────
// SCHEMA: hr
// ─────────────────────────────────────────────

model EmployeeType {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String  @db.VarChar(100)
  code           String  @db.VarChar(50)
  category       String  @db.VarChar(50)
  description    String?
  status         String  @default("ACTIVE") @db.VarChar(20)

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@map("employee_types")
  @@schema("hr")
}

model Department {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  campusId       String? @map("campus_id")
  name           String  @db.VarChar(100)
  code           String  @db.VarChar(50)
  headEmployeeId String? @map("head_employee_id")
  status         String  @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  campus       Campus?      @relation(fields: [campusId], references: [id])
  employees    Employee[]

  @@map("departments")
  @@schema("hr")
}

model Designation {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String  @db.VarChar(100)
  code           String  @db.VarChar(50)
  description    String?
  status         String  @default("ACTIVE") @db.VarChar(20)

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@map("designations")
  @@schema("hr")
}

model Employee {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  personId          String    @unique @map("person_id")
  employeeNumber    String    @map("employee_number") @db.VarChar(50)
  employeeTypeId    String?   @map("employee_type_id")
  departmentId      String?   @map("department_id")
  designationId     String?   @map("designation_id")
  campusId          String?   @map("campus_id")
  joiningDate       DateTime  @map("joining_date") @db.Date
  employmentStatus  String    @default("ACTIVE") @map("employment_status") @db.VarChar(20)
  reportingManagerId String?  @map("reporting_manager_id")
  leavingDate       DateTime? @map("leaving_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  organization     Organization   @relation(fields: [organizationId], references: [id])
  person           Person         @relation(fields: [personId], references: [id])
  employeeType     EmployeeType?  @relation(fields: [employeeTypeId], references: [id])
  department       Department?    @relation(fields: [departmentId], references: [id])
  designation      Designation?   @relation(fields: [designationId], references: [id])
  campus           Campus?        @relation(fields: [campusId], references: [id])
  reportingManager Employee?      @relation("ManagerReports", fields: [reportingManagerId], references: [id])
  directReports    Employee[]     @relation("ManagerReports")
  teacherAssignments TeacherAssignment[]
  employeeAttendance EmployeeAttendance[]
  leaveRequests    LeaveRequest[]

  @@unique([organizationId, employeeNumber])
  @@map("employees")
  @@schema("hr")
}

// ─────────────────────────────────────────────
// SCHEMA: academics
// ─────────────────────────────────────────────

model AcademicYear {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String   @db.VarChar(100)
  code           String   @db.VarChar(20)
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  status         String   @default("UPCOMING") @db.VarChar(20)
  isCurrent      Boolean  @default(false) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id])
  studentEnrollments StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  classSubjects      ClassSubject[]
  timetables         Timetable[]

  @@unique([organizationId, code])
  @@map("academic_years")
  @@schema("academics")
}

model AcademicClass {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String  @db.VarChar(50)
  code           String  @db.VarChar(20)
  level          Int?
  displayOrder   Int?    @map("display_order")
  status         String  @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id])
  sections          Section[]
  teacherAssignments TeacherAssignment[]
  classSubjects     ClassSubject[]
  studentEnrollments StudentEnrollment[]

  @@map("academic_classes")
  @@schema("academics")
}

model Section {
  id              String  @id @default(uuid())
  campusId        String  @map("campus_id")
  academicClassId String  @map("academic_class_id")
  name            String  @db.VarChar(10)
  code            String  @db.VarChar(10)
  capacity        Int?
  status          String  @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  campus         Campus        @relation(fields: [campusId], references: [id])
  academicClass  AcademicClass @relation(fields: [academicClassId], references: [id])
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]
  timetableEntries   TimetableEntry[]

  @@unique([campusId, academicClassId, code])
  @@map("sections")
  @@schema("academics")
}

model Subject {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String  @db.VarChar(100)
  code           String  @db.VarChar(50)
  subjectType    String  @map("subject_type") @db.VarChar(20)
  description    String?
  status         String  @default("ACTIVE") @db.VarChar(20)

  organization      Organization       @relation(fields: [organizationId], references: [id])
  classSubjects     ClassSubject[]
  teacherAssignments TeacherAssignment[]
  timetableEntries  TimetableEntry[]

  @@unique([organizationId, code])
  @@map("subjects")
  @@schema("academics")
}

model ClassSubject {
  id             String  @id @default(uuid())
  academicYearId String  @map("academic_year_id")
  classId        String  @map("class_id")
  subjectId      String  @map("subject_id")
  isOptional     Boolean @default(false) @map("is_optional")
  maxMarks       Decimal? @map("max_marks") @db.Decimal(6, 2)
  passingMarks   Decimal? @map("passing_marks") @db.Decimal(6, 2)
  weightage      Decimal? @db.Decimal(5, 2)
  status         String  @default("ACTIVE") @db.VarChar(20)

  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  class        AcademicClass @relation(fields: [classId], references: [id])
  subject      Subject       @relation(fields: [subjectId], references: [id])

  @@unique([academicYearId, classId, subjectId])
  @@map("class_subjects")
  @@schema("academics")
}

model TeacherAssignment {
  id             String    @id @default(uuid())
  academicYearId String    @map("academic_year_id")
  teacherId      String    @map("teacher_id")
  classId        String    @map("class_id")
  sectionId      String    @map("section_id")
  subjectId      String    @map("subject_id")
  isClassTeacher Boolean   @default(false) @map("is_class_teacher")
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  status         String    @default("ACTIVE") @db.VarChar(20)

  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  teacher      Employee      @relation(fields: [teacherId], references: [id])
  class        AcademicClass @relation(fields: [classId], references: [id])
  section      Section       @relation(fields: [sectionId], references: [id])
  subject      Subject       @relation(fields: [subjectId], references: [id])

  @@map("teacher_assignments")
  @@schema("academics")
}

model Building {
  id        String   @id @default(uuid())
  campusId  String   @map("campus_id")
  name      String   @db.VarChar(100)
  code      String   @db.VarChar(20)
  description String?
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campus Campus @relation(fields: [campusId], references: [id])
  rooms  Room[]

  @@map("buildings")
  @@schema("academics")
}

model Room {
  id         String  @id @default(uuid())
  campusId   String  @map("campus_id")
  buildingId String? @map("building_id")
  name       String  @db.VarChar(100)
  code       String  @db.VarChar(20)
  roomType   String  @map("room_type") @db.VarChar(30)
  capacity   Int?
  status     String  @default("ACTIVE") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  building         Building?       @relation(fields: [buildingId], references: [id])
  timetableEntries TimetableEntry[]

  @@map("rooms")
  @@schema("academics")
}

model Period {
  id           String  @id @default(uuid())
  campusId     String  @map("campus_id")
  name         String  @db.VarChar(50)
  periodNumber Int     @map("period_number")
  startTime    DateTime @map("start_time") @db.Time
  endTime      DateTime @map("end_time") @db.Time
  periodType   String  @map("period_type") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campus           Campus           @relation(fields: [campusId], references: [id])
  timetableEntries TimetableEntry[]

  @@map("periods")
  @@schema("academics")
}

model Timetable {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  campusId       String    @map("campus_id")
  academicYearId String    @map("academic_year_id")
  name           String    @db.VarChar(100)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  status         String    @default("DRAFT") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id])
  entries      TimetableEntry[]

  @@map("timetables")
  @@schema("academics")
}

model TimetableEntry {
  id          String  @id @default(uuid())
  timetableId String  @map("timetable_id")
  dayOfWeek   Int     @map("day_of_week") @db.SmallInt
  periodId    String  @map("period_id")
  classId     String  @map("class_id")
  sectionId   String  @map("section_id")
  subjectId   String? @map("subject_id")
  teacherId   String? @map("teacher_id")
  roomId      String? @map("room_id")

  timetable Timetable     @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  period    Period        @relation(fields: [periodId], references: [id])
  section   Section       @relation(fields: [sectionId], references: [id])
  subject   Subject?      @relation(fields: [subjectId], references: [id])
  room      Room?         @relation(fields: [roomId], references: [id])

  // Conflict prevention: one class/section per period per day
  @@unique([timetableId, dayOfWeek, periodId, sectionId])
  @@map("timetable_entries")
  @@schema("academics")
}

// ─────────────────────────────────────────────
// SCHEMA: students
// ─────────────────────────────────────────────

model Student {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  personId         String    @unique @map("person_id")
  admissionNumber  String    @map("admission_number") @db.VarChar(50)
  registrationNumber String? @map("registration_number") @db.VarChar(50)
  admissionDate    DateTime  @map("admission_date") @db.Date
  joiningDate      DateTime? @map("joining_date") @db.Date
  studentStatus    String    @default("ACTIVE") @map("student_status") @db.VarChar(20)
  leavingDate      DateTime? @map("leaving_date") @db.Date
  leavingReason    String?   @map("leaving_reason")
  currentCampusId  String?   @map("current_campus_id")
  houseId          String?   @map("house_id")
  religion         String?   @db.VarChar(50)
  category         String?   @db.VarChar(50)
  caste            String?   @db.VarChar(100)
  studentType      String?   @map("student_type") @db.VarChar(30)
  admissionSource  String?   @map("admission_source") @db.VarChar(30)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  organization      Organization       @relation(fields: [organizationId], references: [id])
  person            Person             @relation(fields: [personId], references: [id])
  house             House?             @relation(fields: [houseId], references: [id])
  studentGuardians  StudentGuardian[]
  enrollments       StudentEnrollment[]
  attendance        StudentAttendance[]
  houseMemberships  StudentHouseMembership[]

  @@unique([organizationId, admissionNumber])
  @@map("students")
  @@schema("students")
}

model Guardian {
  id          String    @id @default(uuid())
  personId    String    @unique @map("person_id")
  occupation  String?   @db.VarChar(100)
  employer    String?   @db.VarChar(200)
  annualIncome Decimal? @map("annual_income") @db.Decimal(12, 2)
  education   String?   @db.VarChar(100)
  designation String?   @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  person          Person           @relation(fields: [personId], references: [id])
  studentGuardians StudentGuardian[]

  @@map("guardians")
  @@schema("students")
}

model StudentGuardian {
  id                      String  @id @default(uuid())
  studentId               String  @map("student_id")
  guardianId              String  @map("guardian_id")
  relationship            String  @db.VarChar(30)
  isPrimary               Boolean @default(false) @map("is_primary")
  isEmergencyContact      Boolean @default(false) @map("is_emergency_contact")
  canPickup               Boolean @default(false) @map("can_pickup")
  canReceiveNotifications Boolean @default(true) @map("can_receive_notifications")
  canAccessPortal  Boolean   @default(false) @map("can_access_portal")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@map("student_guardians")
  @@schema("students")
}

model StudentEnrollment {
  id               String    @id @default(uuid())
  studentId        String    @map("student_id")
  academicYearId   String    @map("academic_year_id")
  campusId         String    @map("campus_id")
  classId          String    @map("class_id")
  sectionId        String    @map("section_id")
  rollNumber       String?   @map("roll_number") @db.VarChar(20)
  classTeacherId   String?   @map("class_teacher_id")
  enrollmentDate   DateTime  @map("enrollment_date") @db.Date
  status           String    @default("ACTIVE") @db.VarChar(20)
  promotionStatus  String?   @map("promotion_status") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  student      Student       @relation(fields: [studentId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  class        AcademicClass @relation(fields: [classId], references: [id])
  section      Section       @relation(fields: [sectionId], references: [id])
  attendance   StudentAttendance[]

  @@unique([studentId, academicYearId])
  @@map("student_enrollments")
  @@schema("students")
}

model House {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String  @db.VarChar(100)
  code           String  @db.VarChar(20)
  color          String? @db.VarChar(20)
  description    String?
  status         String  @default("ACTIVE") @db.VarChar(20)

  students   Student[]
  memberships StudentHouseMembership[]

  @@map("houses")
  @@schema("students")
}

model StudentHouseMembership {
  id             String @id @default(uuid())
  studentId      String @map("student_id")
  houseId        String @map("house_id")
  academicYearId String @map("academic_year_id")

  student Student @relation(fields: [studentId], references: [id])
  house   House   @relation(fields: [houseId], references: [id])

  @@unique([studentId, academicYearId])
  @@map("student_house_memberships")
  @@schema("students")
}

// ─────────────────────────────────────────────
// SCHEMA: attendance
// ─────────────────────────────────────────────

model StudentAttendance {
  id           String    @id @default(uuid())
  studentId    String    @map("student_id")
  enrollmentId String    @map("enrollment_id")
  date         DateTime  @db.Date
  status       String    @db.VarChar(20)
  checkInTime  DateTime? @map("check_in_time") @db.Time
  checkOutTime DateTime? @map("check_out_time") @db.Time
  remarks      String?
  markedBy     String?   @map("marked_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  student    Student           @relation(fields: [studentId], references: [id])
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([studentId, date])
  @@map("student_attendance")
  @@schema("attendance")
}

model EmployeeAttendance {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  campusId     String    @map("campus_id")
  date         DateTime  @db.Date
  status       String    @db.VarChar(20)
  checkInTime  DateTime? @map("check_in_time") @db.Time
  checkOutTime DateTime? @map("check_out_time") @db.Time
  workHours    Decimal?  @map("work_hours") @db.Decimal(4, 2)
  remarks      String?
  markedBy     String?   @map("marked_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@map("employee_attendance")
  @@schema("attendance")
}

model LeaveType {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String  @db.VarChar(100)
  code           String  @db.VarChar(50)
  applicableTo   String  @map("applicable_to") @db.VarChar(30)
  annualLimit    Int?    @map("annual_limit")
  isPaid         Boolean @default(true) @map("is_paid")
  carryForward   Boolean @default(false) @map("carry_forward")
  status         String  @default("ACTIVE") @db.VarChar(20)

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@map("leave_types")
  @@schema("attendance")
}

model LeaveBalance {
  id             String @id @default(uuid())
  employeeId     String @map("employee_id")
  leaveTypeId    String @map("leave_type_id")
  academicYearId String @map("academic_year_id")
  allocated      Int    @default(0)
  used           Int    @default(0)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, academicYearId])
  @@map("leave_balances")
  @@schema("attendance")
}

model LeaveRequest {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  employeeId       String    @map("employee_id")
  leaveTypeId      String    @map("leave_type_id")
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime  @map("end_date") @db.Date
  totalDays        Int       @map("total_days")
  reason           String?
  status           String    @default("PENDING") @db.VarChar(20)
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  rejectionReason  String?   @map("rejection_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  substitutionRequests SubstitutionRequest[]

  @@map("leave_requests")
  @@schema("attendance")
}

model SubstitutionRequest {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  leaveRequestId String   @map("leave_request_id")
  academicYearId String   @map("academic_year_id")
  date           DateTime @db.Date
  status         String   @default("PENDING") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  leaveRequest LeaveRequest           @relation(fields: [leaveRequestId], references: [id])
  assignments  SubstitutionAssignment[]
  candidateScores SubstitutionCandidateScore[]

  @@map("substitution_requests")
  @@schema("attendance")
}

model SubstitutionAssignment {
  id                    String    @id @default(uuid())
  substitutionRequestId String    @map("substitution_request_id")
  timetableEntryId      String    @map("timetable_entry_id")
  originalTeacherId     String    @map("original_teacher_id")
  substituteTeacherId   String?   @map("substitute_teacher_id")
  algorithmScore        Decimal?  @map("algorithm_score") @db.Decimal(6, 2)
  status                String    @default("SUGGESTED") @db.VarChar(20)
  assignedBy            String?   @map("assigned_by")
  notifiedAt            DateTime? @map("notified_at")
  confirmedAt           DateTime? @map("confirmed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  substitutionRequest SubstitutionRequest @relation(fields: [substitutionRequestId], references: [id])

  @@map("substitution_assignments")
  @@schema("attendance")
}

model SubstitutionCandidateScore {
  id                    String   @id @default(uuid())
  substitutionRequestId String   @map("substitution_request_id")
  candidateEmployeeId   String   @map("candidate_employee_id")
  subjectProficiencyScore Decimal @map("subject_proficiency_score") @db.Decimal(5, 2)
  workloadScore         Decimal  @map("workload_score") @db.Decimal(5, 2)
  fairnessScore         Decimal  @map("fairness_score") @db.Decimal(5, 2)
  departmentAffinityScore Decimal @map("department_affinity_score") @db.Decimal(5, 2)
  totalScore            Decimal  @map("total_score") @db.Decimal(6, 2)
  disqualifiedReason    String?  @map("disqualified_reason")
  createdAt             DateTime @default(now()) @map("created_at")

  substitutionRequest SubstitutionRequest @relation(fields: [substitutionRequestId], references: [id])

  @@map("substitution_candidate_scores")
  @@schema("attendance")
}

// ─────────────────────────────────────────────
// SCHEMA: storage
// ─────────────────────────────────────────────

model File {
  id              String   @id @default(uuid())
  organizationId  String?  @map("organization_id")
  storageProvider String   @map("storage_provider") @db.VarChar(20)
  storageKey      String   @map("storage_key") @db.VarChar(500)
  originalName    String   @map("original_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  sizeBytes       BigInt   @map("size_bytes")
  checksum        String?  @db.VarChar(64)
  uploadedBy      String?  @map("uploaded_by")
  createdAt       DateTime @default(now()) @map("created_at")

  documents              Document[]
  admissionDocuments     AdmissionDocument[]
  homeworkSubmissionFiles HomeworkSubmissionFile[]

  @@map("files")
  @@schema("filestore")
}

model Document {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  fileId             String    @map("file_id")
  documentType       String    @map("document_type") @db.VarChar(100)
  entityType         String    @map("entity_type") @db.VarChar(100)
  entityId           String    @map("entity_id")
  verificationStatus String    @default("PENDING") @map("verification_status") @db.VarChar(20)
  verifiedBy         String?   @map("verified_by")
  verifiedAt         DateTime? @map("verified_at")
  expiryDate         DateTime? @map("expiry_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  file File @relation(fields: [fileId], references: [id])

  @@map("documents")
  @@schema("filestore")
}

// ─────────────────────────────────────────────
// SCHEMA: admissions
// ─────────────────────────────────────────────

model AdmissionEnquiry {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  campusId          String?  @map("campus_id")
  academicYearId    String?  @map("academic_year_id")
  studentName       String   @map("student_name") @db.VarChar(200)
  parentName        String?  @map("parent_name") @db.VarChar(200)
  phone             String   @db.VarChar(30)
  email             String?  @db.VarChar(255)
  classInterestedId String?  @map("class_interested_id")
  source            String   @db.VarChar(30)
  status            String   @default("NEW") @db.VarChar(30)
  assignedTo        String?  @map("assigned_to")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  applications AdmissionApplication[]

  @@map("admission_enquiries")
  @@schema("admissions")
}

model AdmissionApplication {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  enquiryId         String?   @map("enquiry_id")
  applicationNumber String    @map("application_number") @db.VarChar(50)
  academicYearId    String    @map("academic_year_id")
  classId           String    @map("class_id")
  studentPersonId   String?   @map("student_person_id")
  status            String    @default("DRAFT") @db.VarChar(30)
  submittedAt       DateTime? @map("submitted_at")
  approvedAt        DateTime? @map("approved_at")
  rejectedAt        DateTime? @map("rejected_at")
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  enquiry   AdmissionEnquiry? @relation(fields: [enquiryId], references: [id])
  documents AdmissionDocument[]

  @@unique([organizationId, applicationNumber])
  @@map("admission_applications")
  @@schema("admissions")
}

model AdmissionDocument {
  id                 String    @id @default(uuid())
  applicationId      String    @map("application_id")
  documentType       String    @map("document_type") @db.VarChar(50)
  fileId             String    @map("file_id")
  verificationStatus String    @default("PENDING") @map("verification_status") @db.VarChar(20)
  verifiedBy         String?   @map("verified_by")
  verifiedAt         DateTime? @map("verified_at")
  remarks            String?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file        File                 @relation(fields: [fileId], references: [id])

  @@map("admission_documents")
  @@schema("admissions")
}

// ─────────────────────────────────────────────
// SCHEMA: finance
// ─────────────────────────────────────────────

model FeeHead {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String  @db.VarChar(100)
  code           String  @db.VarChar(50)
  category       String  @db.VarChar(30)
  isRefundable   Boolean @default(false) @map("is_refundable")
  status         String  @default("ACTIVE") @db.VarChar(20)

  feeStructureItems FeeStructureItem[]
  feeInvoiceItems   FeeInvoiceItem[]

  @@unique([organizationId, code])
  @@map("fee_heads")
  @@schema("finance")
}

model FeeStructure {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  academicYearId String   @map("academic_year_id")
  classId        String   @map("class_id")
  name           String   @db.VarChar(200)
  status         String   @default("DRAFT") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  items              FeeStructureItem[]
  studentAssignments StudentFeeAssignment[]

  @@map("fee_structures")
  @@schema("finance")
}

model FeeStructureItem {
  id              String  @id @default(uuid())
  feeStructureId  String  @map("fee_structure_id")
  feeHeadId       String  @map("fee_head_id")
  amount          Decimal @db.Decimal(12, 2)
  frequency       String  @db.VarChar(20)
  dueDay          Int?    @map("due_day")

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id])

  @@map("fee_structure_items")
  @@schema("finance")
}

model StudentFeeAssignment {
  id               String    @id @default(uuid())
  studentId        String    @map("student_id")
  enrollmentId     String    @map("enrollment_id")
  feeStructureId   String    @map("fee_structure_id")
  discountAmount   Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  scholarshipAmount Decimal  @default(0) @map("scholarship_amount") @db.Decimal(12, 2)
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  status           String    @default("ACTIVE") @db.VarChar(20)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@map("student_fee_assignments")
  @@schema("finance")
}

model FeeInvoice {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  studentId      String   @map("student_id")
  enrollmentId   String   @map("enrollment_id")
  invoiceNumber  String   @map("invoice_number") @db.VarChar(50)
  invoiceDate    DateTime @map("invoice_date") @db.Date
  dueDate        DateTime @map("due_date") @db.Date
  subtotal       Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  fine           Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  status         String   @default("DRAFT") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  items       FeeInvoiceItem[]
  allocations PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@map("fee_invoices")
  @@schema("finance")
}

model FeeInvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  feeHeadId   String  @map("fee_head_id")
  description String? @db.VarChar(255)
  amount      Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  netAmount   Decimal @map("net_amount") @db.Decimal(12, 2)

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead FeeHead    @relation(fields: [feeHeadId], references: [id])

  @@map("fee_invoice_items")
  @@schema("finance")
}

model FeePayment {
  id                   String   @id @default(uuid())
  organizationId       String   @map("organization_id")
  studentId            String   @map("student_id")
  receiptNumber        String   @map("receipt_number") @db.VarChar(50)
  amount               Decimal  @db.Decimal(12, 2)
  paymentMethod        String   @map("payment_method") @db.VarChar(20)
  transactionReference String?  @map("transaction_reference") @db.VarChar(255)
  paymentDate          DateTime @map("payment_date") @db.Date
  receivedBy           String   @map("received_by")
  gatewayResponse      Json?    @map("gateway_response")
  status               String   @default("PENDING") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  allocations PaymentAllocation[]
  refunds     FeeRefund[]

  @@unique([organizationId, receiptNumber])
  @@map("fee_payments")
  @@schema("finance")
}

model PaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String  @map("payment_id")
  invoiceId String  @map("invoice_id")
  amount    Decimal @db.Decimal(12, 2)

  payment FeePayment @relation(fields: [paymentId], references: [id])
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])

  @@map("payment_allocations")
  @@schema("finance")
}

model FeeRefund {
  id                   String    @id @default(uuid())
  paymentId            String    @map("payment_id")
  refundNumber         String    @map("refund_number") @db.VarChar(50)
  amount               Decimal   @db.Decimal(12, 2)
  reason               String
  refundMethod         String    @map("refund_method") @db.VarChar(20)
  transactionReference String?   @map("transaction_reference") @db.VarChar(255)
  status               String    @default("PENDING") @db.VarChar(20)
  approvedBy           String?   @map("approved_by")
  processedAt          DateTime? @map("processed_at")

  payment FeePayment @relation(fields: [paymentId], references: [id])

  @@map("fee_refunds")
  @@schema("finance")
}

// ─────────────────────────────────────────────
// SCHEMA: hr (payroll extension)
// ─────────────────────────────────────────────

model SalaryComponent {
  id               String  @id @default(uuid())
  organizationId   String  @map("organization_id")
  name             String  @db.VarChar(100)
  code             String  @db.VarChar(50)
  componentType    String  @map("component_type") @db.VarChar(20)
  calculationType  String  @map("calculation_type") @db.VarChar(30)
  isTaxable        Boolean @default(true) @map("is_taxable")
  status           String  @default("ACTIVE") @db.VarChar(20)

  employeeSalaryComponents EmployeeSalaryComponent[]
  payrollItems             PayrollItem[]

  @@map("salary_components")
  @@schema("hr")
}

model SalaryStructure {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  basicSalary   Decimal   @map("basic_salary") @db.Decimal(12, 2)
  grossSalary   Decimal   @map("gross_salary") @db.Decimal(12, 2)
  status        String    @default("ACTIVE") @db.VarChar(20)

  components EmployeeSalaryComponent[]

  @@map("salary_structures")
  @@schema("hr")
}

model EmployeeSalaryComponent {
  id                String   @id @default(uuid())
  salaryStructureId String   @map("salary_structure_id")
  salaryComponentId String   @map("salary_component_id")
  amount            Decimal? @db.Decimal(12, 2)
  percentage        Decimal? @db.Decimal(5, 2)

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@map("employee_salary_components")
  @@schema("hr")
}

model PayrollRun {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  status         String    @default("DRAFT") @db.VarChar(20)
  processedBy    String?   @map("processed_by")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  records PayrollRecord[]

  @@unique([organizationId, periodStart, periodEnd])
  @@map("payroll_runs")
  @@schema("hr")
}

model PayrollRecord {
  id               String  @id @default(uuid())
  payrollRunId     String  @map("payroll_run_id")
  employeeId       String  @map("employee_id")
  workingDays      Int?    @map("working_days")
  presentDays      Int?    @map("present_days")
  basic            Decimal @db.Decimal(12, 2)
  gross            Decimal @db.Decimal(12, 2)
  totalDeductions  Decimal @map("total_deductions") @db.Decimal(12, 2)
  netSalary        Decimal @map("net_salary") @db.Decimal(12, 2)
  status           String  @default("PENDING") @db.VarChar(20)

  payrollRun PayrollRun    @relation(fields: [payrollRunId], references: [id])
  items      PayrollItem[]

  @@map("payroll_records")
  @@schema("hr")
}

model PayrollItem {
  id               String  @id @default(uuid())
  payrollRecordId  String  @map("payroll_record_id")
  salaryComponentId String @map("salary_component_id")
  amount           Decimal @db.Decimal(12, 2)

  payrollRecord   PayrollRecord   @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@map("payroll_items")
  @@schema("hr")
}

// ─────────────────────────────────────────────
// SCHEMA: examinations
// ─────────────────────────────────────────────

model ExamType {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String @db.VarChar(100)
  code           String @db.VarChar(50)

  exams Exam[]

  @@unique([organizationId, code])
  @@map("exam_types")
  @@schema("examinations")
}

model GradingSystem {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String  @db.VarChar(100)
  isDefault      Boolean @default(false) @map("is_default")

  gradeRules GradeRule[]
  exams      Exam[]

  @@map("grading_systems")
  @@schema("examinations")
}

model GradeRule {
  id              String  @id @default(uuid())
  gradingSystemId String  @map("grading_system_id")
  grade           String  @db.VarChar(5)
  minPercentage   Decimal @map("min_percentage") @db.Decimal(5, 2)
  maxPercentage   Decimal @map("max_percentage") @db.Decimal(5, 2)
  gradePoint      Decimal? @map("grade_point") @db.Decimal(4, 2)
  remark          String? @db.VarChar(50)

  gradingSystem GradingSystem @relation(fields: [gradingSystemId], references: [id], onDelete: Cascade)

  @@map("grade_rules")
  @@schema("examinations")
}

model Exam {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  academicYearId String   @map("academic_year_id")
  name           String   @db.VarChar(200)
  examTypeId     String   @map("exam_type_id")
  gradingSystemId String? @map("grading_system_id")
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  status         String   @default("SCHEDULED") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  examType      ExamType       @relation(fields: [examTypeId], references: [id])
  gradingSystem GradingSystem? @relation(fields: [gradingSystemId], references: [id])
  examSubjects  ExamSubject[]
  examResults   ExamResult[]

  @@map("exams")
  @@schema("examinations")
}

model ExamSubject {
  id            String    @id @default(uuid())
  examId        String    @map("exam_id")
  classId       String    @map("class_id")
  subjectId     String    @map("subject_id")
  examDate      DateTime? @map("exam_date") @db.Date
  startTime     DateTime? @map("start_time") @db.Time
  endTime       DateTime? @map("end_time") @db.Time
  maxMarks      Decimal   @map("max_marks") @db.Decimal(6, 2)
  passingMarks  Decimal   @map("passing_marks") @db.Decimal(6, 2)
  weightage     Decimal   @default(100) @db.Decimal(5, 2)

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  examMarks ExamMark[]

  @@map("exam_subjects")
  @@schema("examinations")
}

model ExamMark {
  id            String  @id @default(uuid())
  examSubjectId String  @map("exam_subject_id")
  studentId     String  @map("student_id")
  marks         Decimal? @db.Decimal(6, 2)
  grade         String? @db.VarChar(5)
  isAbsent      Boolean @default(false) @map("is_absent")
  remarks       String?
  enteredBy     String? @map("entered_by")
  verifiedBy    String? @map("verified_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@map("exam_marks")
  @@schema("examinations")
}

model ExamResult {
  id            String  @id @default(uuid())
  examId        String  @map("exam_id")
  studentId     String  @map("student_id")
  totalMarks    Decimal? @map("total_marks") @db.Decimal(8, 2)
  maxTotalMarks Decimal? @map("max_total_marks") @db.Decimal(8, 2)
  percentage    Decimal? @db.Decimal(5, 2)
  grade         String? @db.VarChar(5)
  gradePoint    Decimal? @map("grade_point") @db.Decimal(4, 2)
  resultStatus  String  @map("result_status") @db.VarChar(20)

  exam Exam @relation(fields: [examId], references: [id])

  @@unique([examId, studentId])
  @@map("exam_results")
  @@schema("examinations")
}

model Homework {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  teacherId      String   @map("teacher_id")
  classId        String   @map("class_id")
  sectionId      String   @map("section_id")
  subjectId      String   @map("subject_id")
  title          String   @db.VarChar(255)
  description    String?
  assignedDate   DateTime @map("assigned_date") @db.Date
  dueDate        DateTime @map("due_date") @db.Date
  maxMarks       Decimal? @map("max_marks") @db.Decimal(6, 2)
  status         String   @default("DRAFT") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  submissions HomeworkSubmission[]

  @@map("homework")
  @@schema("examinations")
}

model HomeworkSubmission {
  id          String    @id @default(uuid())
  homeworkId  String    @map("homework_id")
  studentId   String    @map("student_id")
  submittedAt DateTime? @map("submitted_at")
  marks       Decimal?  @db.Decimal(6, 2)
  remarks     String?
  status      String    @default("PENDING") @db.VarChar(20)

  homework Homework                @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  files    HomeworkSubmissionFile[]

  @@unique([homeworkId, studentId])
  @@map("homework_submissions")
  @@schema("examinations")
}

model HomeworkSubmissionFile {
  id           String @id @default(uuid())
  submissionId String @map("submission_id")
  fileId       String @map("file_id")
  sortOrder    Int    @default(0) @map("sort_order")

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  file       File               @relation(fields: [fileId], references: [id])

  @@map("homework_submission_files")
  @@schema("examinations")
}

// ─────────────────────────────────────────────
// SCHEMA: health
// ─────────────────────────────────────────────

model StudentHealthRecord {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  studentId              String    @map("student_id")
  bloodGroup             String?   @map("blood_group") @db.VarChar(5)
  heightCm               Decimal?  @map("height_cm") @db.Decimal(5, 2)
  weightKg               Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  visionLeft             String?   @map("vision_left") @db.VarChar(20)
  visionRight            String?   @map("vision_right") @db.VarChar(20)
  knownAllergies         String[]  @map("known_allergies")
  medicalConditions      String[]  @map("medical_conditions")
  medications            String[]
  specialNeeds           String?   @map("special_needs")
  emergencyContactName   String?   @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone  String?   @map("emergency_contact_phone") @db.VarChar(30)
  doctorName             String?   @map("doctor_name") @db.VarChar(200)
  doctorPhone            String?   @map("doctor_phone") @db.VarChar(30)
  insuranceProvider      String?   @map("insurance_provider") @db.VarChar(200)
  insurancePolicyNumber  String?   @map("insurance_policy_number") @db.VarChar(100)
  recordedAt             DateTime? @map("recorded_at") @db.Date
  recordedBy             String?   @map("recorded_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("student_health_records")
  @@schema("health")
}

// ─────────────────────────────────────────────
// SCHEMA: comms
// ─────────────────────────────────────────────

model Announcement {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  campusId       String?   @map("campus_id")
  title          String    @db.VarChar(255)
  content        String
  audienceType   String    @map("audience_type") @db.VarChar(30)
  targetClassId  String?   @map("target_class_id")
  publishAt      DateTime? @map("publish_at")
  expiresAt      DateTime? @map("expires_at")
  createdBy      String    @map("created_by")
  status         String    @default("DRAFT") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("announcements")
  @@schema("comms")
}

model NotificationTemplate {
  id             String  @id @default(uuid())
  organizationId String? @map("organization_id")
  name           String  @db.VarChar(100)
  eventType      String  @map("event_type") @db.VarChar(100)
  channel        String  @db.VarChar(20)
  subject        String? @db.VarChar(255)
  body           String
  status         String  @default("ACTIVE") @db.VarChar(20)

  @@map("notification_templates")
  @@schema("comms")
}

model Notification {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  recipientUserId  String    @map("recipient_user_id")
  eventType        String    @map("event_type") @db.VarChar(100)
  title            String    @db.VarChar(255)
  message          String
  channel          String    @db.VarChar(20)
  status           String    @default("PENDING") @db.VarChar(20)
  sentAt           DateTime? @map("sent_at")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  deliveries NotificationDelivery[]

  @@map("notifications")
  @@schema("comms")
}

model NotificationDelivery {
  id                String    @id @default(uuid())
  notificationId    String    @map("notification_id")
  provider          String    @db.VarChar(50)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(255)
  status            String    @default("QUEUED") @db.VarChar(20)
  errorMessage      String?   @map("error_message")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("notification_deliveries")
  @@schema("comms")
}

model PtmSchedule {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  campusId            String   @map("campus_id")
  academicYearId      String   @map("academic_year_id")
  name                String   @db.VarChar(200)
  date                DateTime @db.Date
  slotDurationMinutes Int      @default(15) @map("slot_duration_minutes")
  status              String   @default("DRAFT") @db.VarChar(20)
  createdBy           String   @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  teacherSlots PtmTeacherSlot[]
  bookings     PtmBooking[]

  @@map("ptm_schedules")
  @@schema("comms")
}

model PtmTeacherSlot {
  id            String  @id @default(uuid())
  ptmScheduleId String  @map("ptm_schedule_id")
  teacherId     String  @map("teacher_id")
  startTime     DateTime @map("start_time") @db.Time
  endTime       DateTime @map("end_time") @db.Time
  isAvailable   Boolean @default(true) @map("is_available")

  ptmSchedule PtmSchedule @relation(fields: [ptmScheduleId], references: [id], onDelete: Cascade)

  @@map("ptm_teacher_slots")
  @@schema("comms")
}

model PtmBooking {
  id            String   @id @default(uuid())
  ptmScheduleId String   @map("ptm_schedule_id")
  teacherId     String   @map("teacher_id")
  studentId     String   @map("student_id")
  guardianId    String   @map("guardian_id")
  slotStart     DateTime @map("slot_start")
  slotEnd       DateTime @map("slot_end")
  status        String   @default("BOOKED") @db.VarChar(20)
  meetingNotes  String?  @map("meeting_notes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ptmSchedule PtmSchedule @relation(fields: [ptmScheduleId], references: [id])

  @@unique([ptmScheduleId, teacherId, slotStart])
  @@map("ptm_bookings")
  @@schema("comms")
}
