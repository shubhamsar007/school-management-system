{
  "name": "@school/database",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "PRISMA_GENERATE_SKIP_AUTOINSTALL=true prisma generate --schema=../../prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "db:seed": "tsx ../../prisma/seed/index.ts",
    "db:studio": "prisma studio --schema=../../prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "argon2": "^0.43.1"
  },
  "devDependencies": {
    "@school/config": "workspace:*",
    "prisma": "^6.19.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
