# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://school_user:school_password@localhost:5434/school_db"

# ─── Redis ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─── App URLs ───────────────────────────────────────────
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
NODE_ENV="development"
PORT=4000

# ─── Storage (Cloudflare R2) ─────────────────────────────
STORAGE_PROVIDER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# ─── Email (Resend) ──────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@school.com"

# ─── SMS (Twilio) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
